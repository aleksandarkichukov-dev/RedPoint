node_modules/
.pnpm-store/

# builds
.next/
.next-prod/
out/
dist/
build/
.medusa/

# env
.env
.env.*
!.env.example

# key material: PEM files live on disk rather than as escaped .env values.
# The README explaining what belongs there is kept; nothing else is.
apps/backend/secrets/*
!apps/backend/secrets/README.md

# scraper output: regenerable, and it is the client's live catalogue data.
# The scraper source is the work; its output is not.
seed/images/
seed/products.json
seed/reports/
tools/scraper/.cache/

# compiled shared package
packages/catalog/dist/

# typescript incremental build state
*.tsbuildinfo

# product photography the seed copies in for the local file provider
apps/backend/static/

# admin build, copied here so `medusa start` finds it — see CLAUDE.md
apps/backend/public/

# os / editor
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# claude local settings
.claude/settings.local.json
