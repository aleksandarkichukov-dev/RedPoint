# Copy to .env and fill in. Never commit .env.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=redpoint
POSTGRES_PASSWORD=
POSTGRES_DB=redpoint
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Medusa backend ---------------------------------------------------------
DATABASE_URL=postgres://redpoint:CHANGEME@localhost:5432/redpoint
REDIS_URL=redis://localhost:6379
MEDUSA_BACKEND_URL=http://localhost:9000

# "shared" runs API and worker in one process, which is right for a laptop.
# On the VPS run two containers: one "server" and one "worker".
MEDUSA_WORKER_MODE=shared

STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Generate real values before anything leaves the laptop.
JWT_SECRET=
COOKIE_SECRET=

# --- Storefront -------------------------------------------------------------
# Read at run time, so a production image is not tied to one backend address or
# one key. Neither is used in the browser — every call to Medusa happens on the
# server — so neither needs the NEXT_PUBLIC_ prefix, which would compile them
# into the bundle at build time and make the publishable key a rebuild rather
# than a restart. It changes exactly once, at go-live, on a server that cannot
# build. The NEXT_PUBLIC_ names are still read as a fallback.
MEDUSA_BACKEND_URL=http://localhost:9000
# Printed by `pnpm --filter @redpoint/backend seed`. The Store API rejects
# every request without it, and the shop renders empty with no error.
MEDUSA_PUBLISHABLE_KEY=
# The public address of the shop: the sitemap, the canonical tags and
# everything Facebook, Viber and Google read. The new domain is redpointbg.com.
# The old red-point.bg is forwarded to it by nginx and has to stay pointed at
# this server, or the 301 map from the old site never fires.
SITE_URL=https://redpointbg.com
# Card payment, off until myPOS has actually taken one. Nothing has ever been
# paid through them: the signing is proven against the shop's real keys, but
# their checkout page has never been opened and the notification that marks an
# order paid has never run. Meanwhile checkout offers cash on delivery only,
# and the server refuses a card order even if the browser sends one.
#
# Set to "on" once a real card has been charged AND the notification arrived.
# Any other value, including empty, means off.
CARD_PAYMENT=

# --- Влез с Google ----------------------------------------------------------
# Both or neither, like SendGrid. With them absent the shop offers email and
# password only, and never shows a button that cannot work.
#
# The client creates these themselves at console.cloud.google.com: a project,
# then APIs & Services > Credentials > Create credentials > OAuth client ID >
# Web application. Nobody can do it on their behalf.
#
# The redirect URI must be listed there EXACTLY as below, scheme included, or
# Google refuses with redirect_uri_mismatch on its own page rather than ours:
#   https://redpointbg.com/account/google/callback
#   http://localhost:3000/account/google/callback     (for working locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the callback lives somewhere other than SITE_URL + the path above.
GOOGLE_CALLBACK_URL=

# --- myPOS, Phase 5 ---------------------------------------------------------
# From the myPOS merchant portal: Stores > eCommerce > [store] > Интеграция.
# The wallet number is the same figure myPOS also calls the client number.
#
# The RSA private key and the myPOS certificate are NOT here. They are PEM
# files in apps/backend/secrets/ — a multi-line key escaped into a variable
# fails as a bad signature with nothing useful in the message. See the README
# in that directory.
MYPOS_SID=
MYPOS_WALLET=
MYPOS_KEY_INDEX=
# true points at myPOS's test checkout, which charges nobody. Must be false,
# with real values above, before the shop takes a live payment.
MYPOS_SANDBOX=true

# --- Speedy, Phase 6 --------------------------------------------------------
# Speedy authenticate every call, offices included — there is no public
# endpoint. The client number comes from the contract, not from the portal.
SPEEDY_USERNAME=
SPEEDY_PASSWORD=
SPEEDY_CLIENT_NUMBER=

# --- Econt, Phase 6 ---------------------------------------------------------
# ECONT_SHOP_ID is the `id_shop` their delivery widget takes as a mandatory
# parameter; without it the iframe cannot be embedded at all.
ECONT_USERNAME=
ECONT_PASSWORD=
ECONT_SHOP_ID=

# Both couriers issue separate test credentials. Keep this true until the shop
# is live, so no real waybill is ever created by a test order.
COURIERS_SANDBOX=true

# --- Email --------------------------------------------------------------------
# Both or neither. With only one set the backend warns at boot and keeps
# writing email to the log rather than sending it — a half-configured mail
# setup is the failure nobody sees.
#
# SENDGRID_FROM must be an address SendGrid has been shown belongs to us, or
# every send is rejected. Two ways to do that in their portal:
#   Single Sender Verification — one address, confirmed by clicking a link.
#     Five minutes, enough to prove the plumbing works.
#   Domain Authentication — DNS records on the domain. Slower, and what keeps
#     the mail out of spam. Worth doing only once the live domain is settled.
#
# Quote the key if it contains a '#'. An unquoted '#' starts a comment and
# truncates the value silently — the file looks right and the API says the
# credentials are wrong. This cost an evening on the Speedy password.
SENDGRID_API_KEY=
SENDGRID_FROM=

# Where check-order-email.ts sends its test message. Yours, not a customer's.
EMAIL_TEST_RECIPIENT=

# --- Added in later phases --------------------------------------------------
# Phase 8: newsletter provider, chatbot search index
