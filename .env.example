# Copy to .env and fill in. Never commit .env.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=redpoint
POSTGRES_PASSWORD=
POSTGRES_DB=redpoint
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Medusa backend ---------------------------------------------------------
DATABASE_URL=postgres://redpoint:CHANGEME@localhost:5432/redpoint
REDIS_URL=redis://localhost:6379
MEDUSA_BACKEND_URL=http://localhost:9000

# "shared" runs API and worker in one process, which is right for a laptop.
# On the VPS run two containers: one "server" and one "worker".
MEDUSA_WORKER_MODE=shared

STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Generate real values before anything leaves the laptop.
JWT_SECRET=
COOKIE_SECRET=

# --- Storefront -------------------------------------------------------------
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Printed by `pnpm --filter @redpoint/backend seed`. The Store API rejects
# every request without it.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# --- myPOS, Phase 5 ---------------------------------------------------------
# From the myPOS merchant portal: Stores > eCommerce > [store] > Интеграция.
# The wallet number is the same figure myPOS also calls the client number.
#
# The RSA private key and the myPOS certificate are NOT here. They are PEM
# files in apps/backend/secrets/ — a multi-line key escaped into a variable
# fails as a bad signature with nothing useful in the message. See the README
# in that directory.
MYPOS_SID=
MYPOS_WALLET=
MYPOS_KEY_INDEX=
# true points at myPOS's test checkout, which charges nobody. Must be false,
# with real values above, before the shop takes a live payment.
MYPOS_SANDBOX=true

# --- Added in later phases --------------------------------------------------
# Phase 6: SPEEDY_USERNAME, SPEEDY_PASSWORD, ECONT_USERNAME, ECONT_PASSWORD
